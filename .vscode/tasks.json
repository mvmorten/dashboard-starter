{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/DashboardStarter.slnx"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      // Runs `npm run dev` in src/Web and keeps it running. The debugger waits until Vite
      // prints "ready in", then opens the browser. Needs `npm install` in src/Web first.
      "label": "web: dev server",
      "type": "npm",
      "script": "dev",
      "path": "src/Web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
