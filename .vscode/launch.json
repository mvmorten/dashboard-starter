{
  // Run and debug from VS Code (F5). These do the same as the commands in the README's
  // "Getting started"; SQL Server still runs in Docker (`docker compose up -d --wait`).
  // .NET debugging needs the C# extension (ms-dotnettools.csharp).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/Api/bin/Debug/net10.0/DashboardStarter.Api.dll",
      "cwd": "${workspaceFolder}/src/Api",
      // Same settings as the "http" profile in src/Api/Properties/launchSettings.json.
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Db: migrate",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/Db/bin/Debug/net10.0/DashboardStarter.Db.dll",
      "args": ["migrate"],
      "cwd": "${workspaceFolder}/src/Db",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Db: seed",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build",
      "program": "${workspaceFolder}/src/Db/bin/Debug/net10.0/DashboardStarter.Db.dll",
      "args": ["seed"],
      "cwd": "${workspaceFolder}/src/Db",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal"
    },
    {
      // Starts the Vite dev server (if it isn't running yet), then opens Chrome with the
      // debugger attached, so breakpoints in .tsx files work.
      "name": "Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "web: dev server",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src/Web"
    }
  ],
  "compounds": [
    {
      // The whole app: API, Vite dev server, and Chrome. If the page loads before the API
      // has finished starting, the API check shows red; refresh the page.
      "name": "API + Web",
      "configurations": ["API", "Web (Chrome)"],
      "stopAll": true
    }
  ]
}
