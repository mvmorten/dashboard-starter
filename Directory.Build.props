<Project>
  <!-- Settings shared by every .NET project in the repo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Every file lists its own using lines. -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- A clean build means zero warnings. Code style from .editorconfig counts too. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      Exception: NuGet audit warnings (a package has a known vulnerability) stay warnings.
      A new advisory can be published at any time, and it shouldn't break the build of an
      unrelated change. They still print in every build, including CI, so we see them and
      upgrade on purpose.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
