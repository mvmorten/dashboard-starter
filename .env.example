# Copy this file to .env before running `docker compose up -d`.
# .env is gitignored. These values are for the local development container only.

# SA password for the SQL Server container. It must meet SQL Server's complexity rules
# (at least 8 characters, with three of: uppercase, lowercase, digits, symbols).
#
# The API (src/Api/appsettings.Development.json) and the Db runner (src/Db) use this same
# password by default. If you change it here, also set the connection string for both:
#   ConnectionStrings__Default="Server=127.0.0.1,1433;Database=DashboardStarter;User Id=sa;Password=<your password>;Encrypt=True;TrustServerCertificate=True"
MSSQL_SA_PASSWORD=LocalDevOnly!ChangeMe1
