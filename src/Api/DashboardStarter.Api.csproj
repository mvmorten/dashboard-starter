<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DashboardStarter.Api</RootNamespace>
    <AssemblyName>DashboardStarter.Api</AssemblyName>
    <!-- Lets a developer override the connection string with `dotnet user-secrets` (Development only). -->
    <UserSecretsId>dashboard-starter-api</UserSecretsId>
  </PropertyGroup>

  <!--
    Build stamp, read back by Hosting/BuildInfo.cs. The deploy pipeline passes these with
    dotnet publish -p:BuildNumber=57 -p:BuildCommit=<sha> -p:BuildTime=<UTC time>.
    A local build passes nothing, so no attributes are written and BuildInfo reports nulls.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildNumber" Value="$(BuildNumber)" Condition="'$(BuildNumber)' != ''" />
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" Condition="'$(BuildCommit)' != ''" />
    <AssemblyMetadata Include="BuildTime" Value="$(BuildTime)" Condition="'$(BuildTime)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!--
    The API references the Db runner for its list of migrations (compiled in from /sql),
    so the startup check knows exactly which migrations this build expects.
    It never runs them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Db\DashboardStarter.Db.csproj" />
  </ItemGroup>

</Project>
