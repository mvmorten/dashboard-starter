{
  "ConnectionStrings": {
    // Local development container only. The password must match MSSQL_SA_PASSWORD in .env
    // (copied from .env.example). Changed it? Override this with the ConnectionStrings__Default
    // environment variable or a user secret instead of editing this file.
    // TrustServerCertificate is needed because the container uses a self-signed certificate.
    // 127.0.0.1 rather than localhost: on Windows, SqlClient connections to "localhost"
    // time out behind Docker Desktop's WSL port relay.
    "Default": "Server=127.0.0.1,1433;Database=DashboardStarter;User Id=sa;Password=LocalDevOnly!ChangeMe1;Encrypt=True;TrustServerCertificate=True"
  },

  // The user from the development seed (sql/seed/0002_demo_user_password.sql), shown on the
  // local sign-in page with a "Use demo account" button. Local only, like the password above.
  "Demo": {
    "Email": "demo@example.com",
    "Password": "LocalDevOnly!Demo1"
  }
}
