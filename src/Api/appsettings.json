{
  // No connection string here on purpose. In Development it comes from
  // appsettings.Development.json; everywhere else, set ConnectionStrings__Default
  // in the environment. That way the local dev password can't load in production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      // Prints each request's scope on its log lines, including UserId and TenantId
      // (Hosting/RequestLogScopeMiddleware.cs). FormatterOptions are only read when
      // FormatterName is set too, even though "simple" is already the default.
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",

  // Argon2id settings for new password hashes (OWASP's first recommendation). Raising them
  // is safe: each user is rehashed with the new settings on their next sign-in. The Db runner
  // reads the same names from environment variables (PasswordHashing__Iterations).
  "PasswordHashing": {
    "MemorySizeKiB": 19456,
    "Iterations": 2,
    "Parallelism": 1
  },

  "Auth": {
    // Sliding: a session ends after this long without a request.
    "SessionHours": 8,
    // How long a session check (security stamp, lockout, tenant membership) is cached.
    // The longest a signed-out or removed user can keep working.
    "SessionCheckSeconds": 60,
    "MaxFailedSignIns": 5,
    "LockoutMinutes": 15,
    // Per client IP address.
    "SignInPermitLimit": 10,
    "SignInWindowSeconds": 60
  },

  // Demo sandboxes: "Try the demo" gives each visitor a private user and two tenants
  // (src/Api/Demo). Off by default, so a fork doesn't get an anonymous button that creates
  // accounts. The deploy sets Demo__SandboxesEnabled from the repo variable DEMO_ENABLED.
  "Demo": {
    "SandboxesEnabled": false,
    // A sandbox lasts at most this long...
    "SandboxHours": 24,
    // ...and ends early after this long unused.
    "SandboxIdleMinutes": 120,
    // Past this many at once, "Try the demo" answers "The demo is busy".
    "MaxActiveSandboxes": 500,
    // New sandboxes per client IP address (IPv6: per /64) per window.
    "SandboxPermitLimit": 10,
    "SandboxWindowMinutes": 60,
    // How often the cleanup service removes expired sandboxes (hh:mm:ss). Also once at startup.
    "CleanupInterval": "01:00:00"
  },

  "PasswordReset": {
    // How long a reset link works: 30 minutes.
    "TokenLifetimeSeconds": 1800,
    // Reset emails one address can get per hour, so "forgot password" can't flood an inbox.
    "MaxEmailsPerHour": 3,
    // Forgot, reset, and change password requests per client IP address per window.
    "PermitLimit": 5,
    "WindowSeconds": 60
  },

  // Password reset emails (Email/EmailSetup.cs). Empty: email is off, and the sign-in page
  // hides "Forgot password?". The deploy sets From and ResendApiKey when EMAIL_ENABLED is true.
  // Links in the emails point at https://CanonicalHost, never at the request's host.
  "Email": {
    "From": "",
    "ResendApiKey": "",
    // Development only: write each email as a text file to this folder instead of sending it.
    "DevFolder": ""
  },

  // Where Data Protection keys live once deployed (Hosting/DataProtectionSetup.cs).
  // Empty: ASP.NET Core's local default. The deploy sets both.
  "DataProtection": {
    "BlobUri": "",
    "KeyId": ""
  }
}
